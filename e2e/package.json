{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Browser journeys (Playwright) against the local test database; see docs/development/testing.md",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.28.2 <11.0.0"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
