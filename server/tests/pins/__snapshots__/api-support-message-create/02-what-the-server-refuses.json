{
  "steps": [
    {
      "step": "no body at all",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "status": 400,
      "answer": {
        "success": false,
        "error": "body is required"
      }
    },
    {
      "step": "an empty text",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": ""
      },
      "status": 400,
      "answer": {
        "success": false,
        "error": "body is required"
      }
    },
    {
      "step": "a text of spaces",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": "  \n "
      },
      "status": 400,
      "answer": {
        "success": false,
        "error": "body is required"
      }
    },
    {
      "step": "a text that is not text",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": 42
      },
      "status": 400,
      "answer": {
        "success": false,
        "error": "body is required"
      }
    },
    {
      "step": "a text of 10001 characters",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": ""
      },
      "status": 400,
      "answer": {
        "success": false,
        "error": "body exceeds 10000 characters"
      }
    },
    {
      "step": "a text of exactly 10000",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": ""
      },
      "status": 200,
      "answer": {
        "success": true,
        "message": {
          "id": "<uuid>",
          "ticketId": "<uuid>",
          "authorName": "Test Recruiter Manager",
          "authorKind": "requester",
          "body": "",
          "createdAt": "<timestamp>"
        }
      }
    },
    {
      "step": "six files",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": "with files",
        "attachments": [
          {},
          {},
          {},
          {},
          {},
          {}
        ]
      },
      "status": 400,
      "answer": {
        "success": false,
        "error": "Maximum 5 attachments allowed"
      }
    },
    {
      "step": "a file under another user's folder",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": "with a file",
        "attachments": [
          {
            "path": "pending/<uuid>/x.txt",
            "fileName": "x.txt",
            "mimeType": "text/plain",
            "sizeBytes": 3
          }
        ]
      },
      "status": 400,
      "answer": {
        "success": false,
        "error": "Invalid attachment path prefix: pending/<uuid>/x.txt"
      }
    },
    {
      "step": "an id that is not a uuid",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/abc/messages",
      "requestBody": {
        "body": "hello"
      },
      "status": 404,
      "answer": {
        "success": false,
        "error": "Not found"
      }
    },
    {
      "step": "a uuid that is no ticket",
      "as": "recruiter_manager",
      "request": "POST /api/support/tickets/<uuid>/messages",
      "requestBody": {
        "body": "hello"
      },
      "status": 404,
      "answer": {
        "success": false,
        "error": "Not found"
      }
    }
  ],
  "messagesSent": [
    {
      "to": [
        "support@example.test"
      ],
      "subject": "[Test Portal] SUP-<number>: Scene for a pin"
    },
    {
      "to": [
        "support@example.test"
      ],
      "subject": "[Test Portal] SUP-<number>: Scene for a pin"
    }
  ]
}
